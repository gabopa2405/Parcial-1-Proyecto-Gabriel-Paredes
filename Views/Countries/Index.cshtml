@model IEnumerable<SakilaWebMVC.Models.Country>

@{
    ViewData["Title"] = "Países";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string currentFilter = ViewBag.CurrentFilter as string ?? "";

    // Lógica para la ventana deslizante (máximo 5 botones numerados)
    int maxPagesToShow = 5;
    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

    if (endPage - startPage + 1 < maxPagesToShow)
    {
        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
    }
}

<div class="container mt-4">
    <h2>Listado de Países (Sakila)</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Barra Superior: Botón Crear y Buscador -->
    <div class="row mt-3 mb-3">
        <div class="col-md-6">
            <a asp-action="Create" class="btn btn-primary">Registrar Nuevo País</a>
        </div>
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex">
                <input type="text" name="searchString" value="@currentFilter" class="form-control me-2" placeholder="Buscar país..." />
                <button type="submit" class="btn btn-outline-secondary">Buscar</button>
                @if (!string.IsNullOrEmpty(currentFilter))
                {
                    <a asp-action="Index" class="btn btn-link text-decoration-none ms-1">Limpiar</a>
                }
            </form>
        </div>
    </div>

    <!-- Tabla -->
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre del País</th>
                <th>Última Actualización</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No se encontraron resultados.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CountryId</td>
                        <td>@item.CountryName</td>
                        <td>@item.LastUpdate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.CountryId" class="btn btn-warning btn-sm">Editar</a>
                            <form asp-action="Delete" asp-route-id="@item.CountryId" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar este país?');">
                                <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Paginación Compacta e Inteligente -->
    @if (totalPages > 1)
    {
        <nav aria-label="Navegación de páginas" class="mt-4">
            <ul class="pagination justify-content-center">
                <!-- Primero -->
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-searchString="@currentFilter">&laquo; Primero</a>
                </li>
                <!-- Anterior -->
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@currentFilter">Anterior</a>
                </li>

                <!-- Números dinámicos acotados -->
                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@currentFilter">@i</a>
                    </li>
                }

                <!-- Siguiente -->
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@currentFilter">Siguiente</a>
                </li>
                <!-- Último -->
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@totalPages" asp-route-searchString="@currentFilter">Último &raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>