@model IEnumerable<SakilaWebMVC.Models.ReportePeliculaViewModel>

@{
    ViewData["Title"] = "Reporte de Películas Más Alquiladas";
    var usuario = Context.Session.GetString("Usuario");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white shadow-sm rounded">
        <h2>Reporte: Top 10 Películas Más Alquiladas</h2>
        <div>
            <span class="badge bg-primary me-2">Admin: @usuario</span>
            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "Peliculas")">Volver al Catálogo</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th># Posición</th>
                        <th>Título de la Película</th>
                        <th class="text-center">Total de Alquileres</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int pos = 1;
                    }
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@pos</strong></td>
                                <td>@item.Titulo</td>
                                <td class="text-center"><span class="badge bg-info text-dark">@item.CantidadAlquileres</span></td>
                            </tr>
                            pos++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">No hay datos suficientes para generar el reporte analítico.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>