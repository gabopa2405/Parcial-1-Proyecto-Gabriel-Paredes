@model IEnumerable<SakilaWebMVC.Models.RentalViewModel>

@{
    ViewData["Title"] = "Mis Alquileres";
    var usuario = Context.Session.GetString("Usuario");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white shadow-sm rounded">
        <h2>Mis Películas Alquiladas</h2>
        <div>
            <span class="badge bg-secondary me-2">Usuario: @usuario</span>
            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "Peliculas")">Volver al Catálogo</a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID Alquiler</th>
                        <th>Película</th>
                        <th>Fecha de Alquiler</th>
                        <th>Fecha de Devolución</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.RentalId</td>
                                <td><strong>@item.FilmTitle</strong></td>
                                <td>@item.RentalDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @if (item.ReturnDate.HasValue)
                                    {
                                        <span class="badge bg-success">Devuelto: @item.ReturnDate.Value.ToString("yyyy-MM-dd HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente de Devolución</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (!item.ReturnDate.HasValue)
                                    {
                                        <form asp-controller="Peliculas" asp-action="Devolver" method="post" style="display:inline;">
                                            <input type="hidden" name="rentalId" value="@item.RentalId" />
                                            <button type="submit" class="btn btn-warning btn-sm">Devolver</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No tienes registros de alquileres activos.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>