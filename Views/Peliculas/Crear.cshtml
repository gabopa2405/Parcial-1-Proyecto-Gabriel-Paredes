@{
    ViewData["Title"] = "Agregar Película";
}

<div class="container mt-4">
    <h2>Agregar Nueva Película</h2>
    <hr />

    <form asp-action="Crear" method="post" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label class="form-label">Título</label>
            <input type="text" name="title" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <textarea name="description" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Año de Lanzamiento</label>
            <input type="number" name="release_year" class="form-control" value="2006" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Duración del Alquiler (días)</label>
            <input type="number" name="rental_duration" class="form-control" value="3" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Precio de Alquiler ($)</label>
            <input type="number" step="0.01" name="rental_rate" class="form-control" value="4.99" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Clasificación (Rating)</label>
            <select name="rating" class="form-select">
                <option value="G">G</option>
                <option value="PG">PG</option>
                <option value="PG-13">PG-13</option>
                <option value="R">R</option>
                <option value="NC-17">NC-17</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success">Guardar Película</button>
        <a class="btn btn-secondary ms-2" href="@Url.Action("Index", "Peliculas")">Cancelar</a>
    </form>
</div>